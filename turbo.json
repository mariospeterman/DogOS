{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@dogos/api#dev": {
      "passThroughEnv": [
        "API_HOST",
        "API_PORT",
        "DATABASE_URL",
        "DIRECT_URL",
        "DOGOS_AUTH_MODE",
        "DOGOS_ENV",
        "DOGOS_COACH_MODEL_FREE",
        "DOGOS_COACH_MODEL_PAID",
        "DOGOS_LLM_CHAT_MAX_OUTPUT_TOKENS",
        "DOGOS_LLM_CHAT_TIMEOUT_MS",
        "DOGOS_LLM_EVIDENCE_MAX_OUTPUT_TOKENS",
        "DOGOS_LLM_EVIDENCE_TIMEOUT_MS",
        "DOGOS_LLM_MODE",
        "DOGOS_LLM_ONBOARDING_MAX_OUTPUT_TOKENS",
        "DOGOS_LLM_ONBOARDING_TIMEOUT_MS",
        "DOGOS_LLM_PLAN_MAX_OUTPUT_TOKENS",
        "DOGOS_LLM_PLAN_TIMEOUT_MS",
        "DOGOS_LLM_SUMMARY_MAX_OUTPUT_TOKENS",
        "DOGOS_LLM_SUMMARY_TIMEOUT_MS",
        "DOGOS_ONBOARDING_MODEL",
        "LOG_LEVEL",
        "NODE_ENV",
        "OPENAI_API_KEY",
        "OPENAI_BASE_URL",
        "OPENAI_DATA_REGION",
        "SIGNED_LINK_SECRET",
        "STRIPE_PRICE_PLUS_CHF",
        "STRIPE_PRICE_PRO_CHF",
        "STRIPE_PRICE_ULTRA_CHF",
        "STRIPE_PRODUCT_PLUS",
        "STRIPE_PRODUCT_PRO",
        "STRIPE_PRODUCT_ULTRA",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "SUPABASE_PROJECT_REF",
        "SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SECRET_KEY",
        "SUPABASE_URL",
        "WEB_ORIGIN"
      ]
    },
    "@dogos/web#dev": {
      "passThroughEnv": [
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_DOGOS_ENV",
        "NEXT_PUBLIC_DOGOS_LOCAL_IDENTITY",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_SUPABASE_URL",
        "WEB_ORIGIN"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
