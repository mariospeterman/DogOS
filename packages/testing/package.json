  },
  "dependencies": {
    "@dogos/contracts": "workspace:*",
    "@dogos/knowledge": "workspace:*",
    "@dogos/observation-engine": "workspace:*",
    "@dogos/progress-engine": "workspace:*",
    "@dogos/safety-engine": "workspace:*",
    "@dogos/training-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  }
}
