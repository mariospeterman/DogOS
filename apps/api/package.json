{
  "name": "@dogos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "NODE_OPTIONS=--conditions=development tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dogos/config": "workspace:*",
    "@dogos/contracts": "workspace:*",
    "@dogos/database": "workspace:*",
    "@dogos/progress-engine": "workspace:*",
    "@dogos/safety-engine": "workspace:*",
    "@dogos/testing": "workspace:*",
    "@dogos/telemetry": "workspace:*",
    "@fastify/swagger": "9.7.0",
    "fastify": "5.10.0",
    "jose": "6.1.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "postgres": "3.4.8",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
