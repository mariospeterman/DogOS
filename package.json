{
  "name": "dogos",
  "version": "0.1.0",
  "private": true,
  "description": "Multilingual dog training platform, Swiss-positioned and DACH-first",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": "11.13.0"
  },
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "build": "turbo run build",
    "check:env": "node scripts/check-env-file.mjs",
    "dev": "node --env-file-if-exists=.env.local ./node_modules/turbo/bin/turbo run dev",
    "supabase": "node scripts/supabase-cli.mjs",
    "dev:services": "node scripts/supabase-cli.mjs start",
    "db:reset": "node scripts/supabase-cli.mjs db reset",
    "db:seed": "node scripts/supabase-cli.mjs db reset",
    "seed": "node scripts/supabase-cli.mjs db reset",
    "db:test": "node scripts/supabase-cli.mjs test db",
    "db:lint": "node scripts/supabase-cli.mjs db lint --local --schema api,private,public --level warning --fail-on warning",
    "db:types": "node scripts/generate-db-types.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --config vitest.config.ts",
    "test:contracts": "vitest run --config vitest.config.ts packages/contracts/src",
    "test:engines": "vitest run --config vitest.config.ts packages/contracts/src packages/knowledge/src packages/safety-engine/src packages/training-engine/src packages/progress-engine/src packages/observation-engine/src packages/testing/src",
    "demo:engines": "pnpm --filter @dogos/testing demo",
    "demo:product": "node scripts/demo-product.mjs",
    "demo:product:check": "node scripts/demo-product.mjs --check",
    "demo:agent-tools": "NODE_OPTIONS=--conditions=development tsx scripts/demo-agent-tools.ts",
    "demo:mcp": "pnpm --filter @dogos/mcp-server demo",
    "mcp:serve": "pnpm --filter @dogos/mcp-server start",
    "smoke:ai": "node --env-file-if-exists=.env.local scripts/smoke-ai-providers.mjs",
    "smoke:ai:required": "node --env-file-if-exists=.env.local scripts/smoke-ai-providers.mjs --require",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.10",
    "google-auth-library": "^10.9.0",
    "prettier": "3.9.5",
    "supabase": "2.109.1",
    "tsx": "4.23.1",
    "turbo": "2.10.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
