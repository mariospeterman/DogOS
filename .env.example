# Shared local runtime. Do not put production credentials in this file.
NODE_ENV=development
DOGOS_ENV=local
LOG_LEVEL=info

# Fastify API
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
USE_MOCK_PROVIDERS=true
SIGNED_LINK_SECRET=local-only-change-before-production-32-chars

# Server-side target used when Next.js exposes API and webhook routes through
# the same public origin. This is never sent to the browser.
DOGOS_INTERNAL_API_URL=http://127.0.0.1:4000

# Next.js browser-safe variables only. Never prefix secrets with NEXT_PUBLIC_.
NEXT_PUBLIC_DOGOS_ENV=local
NEXT_PUBLIC_DOGOS_LOCAL_IDENTITY=owner
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# Hosted Supabase. The publishable key is browser-safe when RLS is enabled.
# Keep the secret key and database URLs server-only.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
SUPABASE_SECRET_KEY=sb_secret_replace-me
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
DOGOS_AUTH_MODE=hybrid
# Use the transaction pooler for the API runtime and the direct/session URL for
# migrations and administrative tooling. Percent-encode special password chars.
DATABASE_URL=postgresql://postgres.your-project-ref:replace-password@aws-0-your-region.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:replace-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# MCP uses deterministic identities only outside production.
DOGOS_MCP_AUTH_MODE=development
DOGOS_MCP_ACTOR=owner
DOGOS_MCP_READ_ONLY=false
# Optional Stripe Billing. Configure the complete set or leave all values empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_PLUS=
STRIPE_PRODUCT_PRO=
STRIPE_PRODUCT_ULTRA=
STRIPE_PRICE_PLUS_CHF=
STRIPE_PRICE_PRO_CHF=
STRIPE_PRICE_ULTRA_CHF=

# Optional purpose-routed natural-language presentation. Canonical plans and
# decisions stay deterministic. EU routing requires an approved OpenAI EU
# data-residency project; setting the region alone does not grant eligibility.
DOGOS_LLM_MODE=deterministic
OPENAI_API_KEY=
OPENAI_DATA_REGION=global
# OPENAI_BASE_URL=https://api.openai.com/v1
DOGOS_COACH_MODEL_FREE=gpt-5.6-luna
DOGOS_COACH_MODEL_PAID=gpt-5.6-terra
# Onboarding is a high-conversion structured extraction flow and defaults to
# the paid-quality model even before a subscription exists.
DOGOS_ONBOARDING_MODEL=gpt-5.6-terra
DOGOS_LLM_ONBOARDING_MAX_OUTPUT_TOKENS=700
DOGOS_LLM_ONBOARDING_TIMEOUT_MS=15000
DOGOS_LLM_CHAT_MAX_OUTPUT_TOKENS=900
DOGOS_LLM_CHAT_TIMEOUT_MS=12000
DOGOS_LLM_EVIDENCE_MAX_OUTPUT_TOKENS=2500
DOGOS_LLM_EVIDENCE_TIMEOUT_MS=30000
DOGOS_LLM_PLAN_MAX_OUTPUT_TOKENS=3000
DOGOS_LLM_PLAN_TIMEOUT_MS=30000
DOGOS_LLM_SUMMARY_MAX_OUTPUT_TOKENS=4000
DOGOS_LLM_SUMMARY_TIMEOUT_MS=45000
