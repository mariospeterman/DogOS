# Shared local runtime. Do not put production credentials in this file.
NODE_ENV=development
DOGOS_ENV=local
DOGOS_RELEASE_CHANNEL=private_pilot
DOGOS_PILOT_GOAL_FAMILY=goal.loose_leash_walking
LOG_LEVEL=info

# Fastify API
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
SIGNED_LINK_SECRET=local-only-change-before-production-32-chars

# Server-side target used when Next.js exposes API and webhook routes through
# the same public origin. This is never sent to the browser.
DOGOS_INTERNAL_API_URL=http://127.0.0.1:4000

# Next.js browser-safe variables only. Never prefix secrets with NEXT_PUBLIC_.
NEXT_PUBLIC_DOGOS_ENV=local
NEXT_PUBLIC_DOGOS_LOCAL_IDENTITY=owner
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_DOGOS_FEATURE_LIVE=false
NEXT_PUBLIC_DOGOS_FEATURE_PROFESSIONAL_MARKETPLACE=false
NEXT_PUBLIC_DOGOS_FEATURE_VOD=true

# Private-pilot feature freeze. Enable only with owner approval and matching
# tests, docs, release manifests, provider credentials, and consent gates.
DOGOS_FEATURE_COACH=true
DOGOS_FEATURE_MEMORY=true
DOGOS_FEATURE_PLAN=true
DOGOS_FEATURE_SESSIONS=true
DOGOS_FEATURE_PROGRESS=true
DOGOS_FEATURE_VOD=true
DOGOS_FEATURE_HANDOFF=true
DOGOS_FEATURE_PROFESSIONAL_REVIEW=true
DOGOS_FEATURE_LIVE=false
DOGOS_FEATURE_HIGH_FREQUENCY_CV=false
DOGOS_FEATURE_CUSTOM_DOG_POSE=false
DOGOS_FEATURE_FAMILY_360=false
DOGOS_FEATURE_PROFESSIONAL_MARKETPLACE=false
DOGOS_FEATURE_CALCOM=false
DOGOS_FEATURE_STRIPE_CONNECT=false
DOGOS_FEATURE_REFERRALS=false
DOGOS_FEATURE_AMBASSADORS=false
DOGOS_FEATURE_AFFILIATES=false
DOGOS_FEATURE_KNOWLEDGE_SCOUT=false
DOGOS_FEATURE_RUNTIME_WEB_SEARCH=false
DOGOS_FEATURE_VECTOR_MEMORY=false
DOGOS_FEATURE_NATIVE_WRAPPERS=false

# Local development uses deterministic local auth. Hosted Supabase values belong
# in .env.local or deployment secrets when testing real Auth/Storage.
DOGOS_AUTH_MODE=local
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
# SUPABASE_SECRET_KEY=sb_secret_replace-me
# SUPABASE_STORAGE_BUCKET=dog-media
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
# Use the transaction pooler for the API runtime and the direct/session URL for
# migrations and administrative tooling. Percent-encode special password chars.
# DATABASE_URL=postgresql://postgres.your-project-ref:replace-password@aws-0-your-region.pooler.supabase.com:6543/postgres?sslmode=require
# DIRECT_URL=postgresql://postgres:replace-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# MCP uses deterministic identities only outside production.
DOGOS_MCP_AUTH_MODE=development
DOGOS_MCP_ACTOR=owner
DOGOS_MCP_READ_ONLY=false
# Optional Stripe Billing. Configure the complete set or leave all values empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_PLUS=
STRIPE_PRODUCT_PRO=
STRIPE_PRODUCT_ULTRA=
STRIPE_PRICE_PLUS_CHF=
STRIPE_PRICE_PRO_CHF=
STRIPE_PRICE_ULTRA_CHF=
REWARDFUL_API_SECRET=
NEXT_PUBLIC_REWARDFUL_SITE_ID=
DOGOS_REWARDFUL_ENABLED=false
DOGOS_REWARDFUL_CLIENT_REFERENCE=true

# Optional partner marketplace, trainer booking, veterinary escalation, and
# affiliate commerce. These are frozen for the private pilot unless
# DOGOS_FEATURE_PROFESSIONAL_MARKETPLACE is explicitly enabled.
DOGOS_PARTNER_MARKETPLACE_ENABLED=false
DOGOS_PARTNER_REDIRECT_BASE_URL=http://localhost:3000/app/referral
DOGOS_AFFILIATE_DISCLOSURE_REQUIRED=true
DOGOS_AFFILIATE_ALLOW_FOOD=false
DOGOS_AFFILIATE_ALLOW_EQUIPMENT=true
DOGOS_TRAINER_MARKETPLACE_ENABLED=true
DOGOS_VETERINARY_ESCALATION_ENABLED=true
CAL_API_KEY=
CAL_API_VERSION=2024-08-13
CAL_BASE_URL=https://api.cal.com/v2
CAL_WEBHOOK_SECRET=
CAL_DEFAULT_EVENT_TYPE_ID=

# Optional purpose-routed natural-language presentation. Canonical plans and
# decisions stay deterministic. EU routing requires an approved OpenAI EU
# data-residency project; setting the region alone does not grant eligibility.
DOGOS_AI_POLICY_VERSION=2026-07-19.1
DOGOS_AI_MODE=hybrid
DOGOS_AI_ORCHESTRATOR=deterministic
DOGOS_AI_FAIL_CLOSED=true
DOGOS_AI_REQUIRE_RELEASE_MANIFEST=true
DOGOS_AI_ALLOW_PREVIEW_MODELS=false
DOGOS_AI_REQUIRED_PROCESSING_REGION=eu
DOGOS_AI_ALLOW_CROSS_BORDER_PERSONAL_DATA=false
DOGOS_AI_ALLOW_PERSONAL_MEDIA_SHADOWING=false
DOGOS_KNOWLEDGE_RELEASE_ID=
DOGOS_LLM_MODE=deterministic
OPENAI_API_KEY=
OPENAI_DATA_REGION=global
DOGOS_AI_RELEASE_MANIFESTS_JSON=[]
DOGOS_MODEL_SNAPSHOT_APPROVAL=
DOGOS_AI_RELEASE_MANIFEST_ONBOARDING_EXTRACT=
DOGOS_AI_RELEASE_MANIFEST_LANGUAGE_DETECT=
DOGOS_AI_RELEASE_MANIFEST_COACH_CHAT=
DOGOS_AI_RELEASE_MANIFEST_PLAN_COMPOSE=
DOGOS_AI_RELEASE_MANIFEST_PLAN_EXPLAIN=
DOGOS_AI_RELEASE_MANIFEST_PROGRESS_EXPLAIN=
DOGOS_AI_RELEASE_MANIFEST_PROFESSIONAL_HANDOFF=
DOGOS_AI_RELEASE_MANIFEST_KNOWLEDGE_RUNTIME_SEARCH=
DOGOS_AI_RELEASE_MANIFEST_KNOWLEDGE_OFFLINE_SCOUT=
DOGOS_AI_RELEASE_MANIFEST_VIDEO_GLOBAL_SEMANTICS=
DOGOS_AI_RELEASE_MANIFEST_VIDEO_REPORT=
DOGOS_AI_RELEASE_MANIFEST_LIVE_STANDARD=
DOGOS_AI_RELEASE_MANIFEST_LIVE_PREMIUM=
DOGOS_AI_RELEASE_MANIFEST_AUDIO_TRANSCRIBE=
DOGOS_AI_RELEASE_MANIFEST_EMBEDDING_GENERATE=
DOGOS_AI_RELEASE_MANIFEST_CONTENT_MODERATE=
DOGOS_AI_RELEASE_MANIFEST_EVAL_JUDGE=
# OPENAI_BASE_URL=https://api.openai.com/v1
DOGOS_TEXT_PROVIDER=openai
DOGOS_TEXT_FAST_MODEL=gpt-5.6-luna
DOGOS_TEXT_COACH_MODEL=gpt-5.6-terra
DOGOS_TEXT_ESCALATION_MODEL=gpt-5.6-sol
DOGOS_TEXT_ESCALATION_ENABLED=false
DOGOS_TEXT_FAILURE_FALLBACK=deterministic
DOGOS_COACH_MODEL_FREE=gpt-5.6-luna
DOGOS_COACH_MODEL_PAID=gpt-5.6-terra
# Onboarding is a structured extraction flow and defaults to the fast model;
# deterministic DogOS services still validate supported goals and safety gates.
DOGOS_ONBOARDING_MODEL=gpt-5.6-luna
DOGOS_LLM_ONBOARDING_MAX_OUTPUT_TOKENS=700
DOGOS_LLM_ONBOARDING_TIMEOUT_MS=15000
DOGOS_LLM_CHAT_MAX_OUTPUT_TOKENS=900
DOGOS_LLM_CHAT_TIMEOUT_MS=12000
DOGOS_LLM_EVIDENCE_MAX_OUTPUT_TOKENS=2500
DOGOS_LLM_EVIDENCE_TIMEOUT_MS=30000
DOGOS_LLM_PLAN_MAX_OUTPUT_TOKENS=3000
DOGOS_LLM_PLAN_TIMEOUT_MS=30000
DOGOS_LLM_SUMMARY_MAX_OUTPUT_TOKENS=4000
DOGOS_LLM_SUMMARY_TIMEOUT_MS=45000
DOGOS_CONTEXT_CHAT_MAX_TOKENS=6000
DOGOS_CONTEXT_PLAN_MAX_TOKENS=12000
DOGOS_CONTEXT_PROGRESS_MAX_TOKENS=10000
DOGOS_CONTEXT_HANDOFF_MAX_TOKENS=16000
DOGOS_CONTEXT_LIVE_MAX_TOKENS=3000

# Optional VOD/CV media analysis. Vertex/Gemini is the target semantic VOD
# provider, while local CV remains disabled until model files and workers are
# explicitly provisioned. Provider outputs are candidates, not canonical truth.
DOGOS_VOD_PROVIDER=disabled
DOGOS_VOD_MODEL=gemini-3.5-flash
DOGOS_VOD_PROVIDER_REGION=
DOGOS_VOD_GLOBAL_PASS_ENABLED=true
DOGOS_VOD_PRECISION_PASS_ENABLED=false
DOGOS_VOD_MAX_SECONDS=180
DOGOS_VOD_MAX_BYTES=262144000
DOGOS_VOD_MAX_EVENT_WINDOWS=12
DOGOS_VOD_TIMEOUT_MS=180000
DOGOS_VOD_SECONDARY_PROVIDER=disabled
DOGOS_VOD_SECONDARY_MODEL=gpt-5.6-terra
DOGOS_VOD_SECONDARY_PERSONAL_MEDIA_ALLOWED=false
DOGOS_VIDEO_WORKER_ENABLED=0
DOGOS_VIDEO_OBJECT_READER=
DOGOS_VIDEO_FRAME_EXTRACTOR=
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=europe-west4
GOOGLE_VERTEX_AUTH_MODE=adc
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_VERTEX_ACCESS_TOKEN=

# Optional audio and local computer-vision stacks.
DOGOS_ASR_PROVIDER=openai
DOGOS_ASR_MODEL=gpt-4o-mini-transcribe
DOGOS_ASR_ESCALATION_MODEL=gpt-4o-transcribe
DOGOS_LOCAL_ASR_ENABLED=false
DOGOS_LOCAL_ASR_MODEL=whisper-turbo
DOGOS_EMBEDDING_PROVIDER=disabled
DOGOS_EMBEDDING_MODEL=text-embedding-3-small
DOGOS_MODERATION_PROVIDER=disabled
DOGOS_MODERATION_MODEL=omni-moderation-latest
DOGOS_CV_ENABLED=false
DOGOS_CV_RUNTIME=onnxruntime
DOGOS_CV_VOD_FPS=15
DOGOS_CV_PRECISION_FPS=30
DOGOS_CV_LIVE_CLIENT_FPS=20
DOGOS_CV_LIVE_SERVER_FPS=10
DOGOS_CV_HANDLER_POSE_CLIENT=mediapipe-pose-landmarker
DOGOS_CV_HANDLER_POSE_SERVER=rtmpose-m
DOGOS_CV_DETECTOR=rtmdet-small
DOGOS_CV_TRACKER=bytetrack
DOGOS_CV_DOG_POSE_BOOTSTRAP=rtmpose-ap10k
DOGOS_CV_CUSTOM_DOG_MODEL=
DOGOS_CV_CUSTOM_DOG_MODEL_VERSION=
DOGOS_EVENT_PRE_ROLL_MS=2000
DOGOS_EVENT_POST_ROLL_MS=4000
DOGOS_MIN_MEDIA_QUALITY_SCORE=0.70
DOGOS_MIN_MEASUREMENT_CONFIDENCE=0.75
DOGOS_ABSTAIN_BELOW_CONFIDENCE=0.65

# Optional LiveKit media transport for live coaching sessions. Configure all
# values together to enable real rooms.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
DOGOS_LIVE_PROVIDER=disabled
DOGOS_LIVE_MODEL=gemini-live-2.5-flash-native-audio
DOGOS_LIVE_FALLBACK_PROVIDER=openai
DOGOS_LIVE_FALLBACK_MODEL=gpt-realtime-2.1-mini
DOGOS_LIVE_PREVIEW_MODEL=gemini-3.1-flash-live-preview
DOGOS_LIVE_PREVIEW_ENABLED=false
DOGOS_LIVE_DEFAULT_MODE=silent_measurement
DOGOS_LIVE_MAX_CUES_PER_MINUTE=4
DOGOS_LIVE_CUE_COOLDOWN_MS=4000
DOGOS_LIVE_RING_BUFFER_SECONDS=15
DOGOS_LIVE_POST_SESSION_VOD=true

# Media privacy defaults.
DOGOS_RAW_MEDIA_TTL_HOURS=48
DOGOS_DERIVED_MEDIA_TTL_HOURS=24
DOGOS_PREVIEW_MEDIA_TTL_HOURS=48
DOGOS_STORE_RAW_PROVIDER_PAYLOADS=false
DOGOS_STORE_RAW_AUDIO_TRANSCRIPTS=false
DOGOS_MEDIA_TRAINING_OPT_IN=false
DOGOS_BYSTANDER_BLUR_RETAINED_PREVIEWS=true
DOGOS_FACE_IDENTIFICATION=false
DOGOS_BIOMETRIC_IDENTIFICATION=false

# Optional WhatsApp/Twilio pilot values. Keep disabled unless the webhook route,
# sender, signature validation, and allowlist are configured for the environment.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_INBOUND_WEBHOOK_URL=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_ALLOWED_TEST_NUMBERS=
