# Shared local runtime. Do not put production credentials in this file.
NODE_ENV=development
DOGOS_ENV=local
LOG_LEVEL=info

# Fastify API
API_HOST=127.0.0.1
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
USE_MOCK_PROVIDERS=true
SIGNED_LINK_SECRET=local-only-change-before-production-32-chars

# Next.js browser-safe variables only. Never prefix secrets with NEXT_PUBLIC_.
NEXT_PUBLIC_DOGOS_ENV=local
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# Hosted Supabase. The publishable key is browser-safe when RLS is enabled.
# Keep the secret key and database URLs server-only.
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
SUPABASE_SECRET_KEY=sb_secret_replace-me
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
DOGOS_AUTH_MODE=hybrid
NEXT_PUBLIC_WHATSAPP_CHAT_URL=https://wa.me/15551617622
# Use the transaction pooler for the API runtime and the direct/session URL for
# migrations and administrative tooling. Percent-encode special password chars.
DATABASE_URL=postgresql://postgres.your-project-ref:replace-password@aws-0-your-region.pooler.supabase.com:6543/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:replace-password@db.your-project-ref.supabase.co:5432/postgres?sslmode=require

# WhatsApp defaults to the local simulator. Meta secrets belong only in an
# uncommitted environment file or secret manager and never in NEXT_PUBLIC_*.
WHATSAPP_MODE=simulator
WHATSAPP_VERIFY_TOKEN=replace-with-separate-random-webhook-token
WHATSAPP_ACCOUNT_LINK_URL=http://127.0.0.1:3000/app/account/link
# WHATSAPP_GRAPH_VERSION=vXX.X
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_TEST_ALLOWLIST=41790000000
# WHATSAPP_PUBLIC_WEBHOOK_URL=https://pilot.example/webhooks/whatsapp

# Twilio Sandbox alternative. Use only joined, allowlisted test numbers. The
# Account SID and Auth Token belong only in .env.local or a secret manager.
# TWILIO_ACCOUNT_SID=AC00000000000000000000000000000000
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_INBOUND_WEBHOOK_URL=https://pilot.example/webhooks/whatsapp/twilio
# TWILIO_STATUS_CALLBACK_URL=https://pilot.example/webhooks/whatsapp/twilio/status
# TWILIO_ALLOWED_TEST_NUMBERS=whatsapp:+41790000000

# MCP uses deterministic identities only outside production.
DOGOS_MCP_AUTH_MODE=development
DOGOS_MCP_ACTOR=owner
DOGOS_MCP_READ_ONLY=false
# Optional Stripe Billing. Configure the complete set or leave all values empty.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_PLUS=
STRIPE_PRODUCT_PRO=
STRIPE_PRODUCT_ULTRA=
STRIPE_PRICE_PLUS_CHF=
STRIPE_PRICE_PRO_CHF=
STRIPE_PRICE_ULTRA_CHF=
